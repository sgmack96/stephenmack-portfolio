---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const digestEntries = await getCollection('digest');
const latestDigest = digestEntries.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
)[0];
---

<Base title="Stephen Mack — Solutions Engineer">
    <section style="margin-bottom: 4rem;">
        <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem;">Stephen Mack</h1>
        <p style="font-size: 1.125rem; color: var(--accent); margin-bottom: 1.5rem;">Solutions Engineer, Cloudflare</p>
        <p style="font-size: 1.125rem; color: var(--text); line-height: 1.7; margin-bottom: 1rem;">
            I build production AI applications on Cloudflare's edge platform.
        </p>
        <p style="color: var(--text-muted); line-height: 1.7;">
            Every project ships to Workers, runs in 300+ cities, and demonstrates platform capabilities I use with startup customers every day.
        </p>
    </section>

    <section style="margin-bottom: 4rem;">
        <h2 style="font-size: 0.8125rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.5rem;">About</h2>

        <div style="display: flex; flex-direction: column; gap: 1rem; color: var(--text-muted); line-height: 1.7;">
            <p>
                I'm a Solutions Engineer at Cloudflare focused on AI infrastructure for startup technology companies. My work involves helping engineering teams understand and deploy Cloudflare's platform — from Workers and D1 to AI Gateway and Zero Trust.
            </p>
            <p>
                I enjoy building with AI agents and diving into the new paradigm — exploring how agents, RAG, and memory systems can be composed into useful products. Each project is an exploration of how these patterns fit together at scale.
            </p>
        </div>
    </section>

    <section>
        <h2 style="font-size: 0.8125rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1.5rem;">Projects</h2>

        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;">
            <!-- FIFA Draft Pool -->
            <a href="/projects/fifa-draft-pool" style="text-decoration: none;">
                <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; transition: border-color 0.15s; height: 100%;" onmouseover="this.style.borderColor='var(--blue)'" onmouseout="this.style.borderColor='var(--border)'">
                    <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.75rem;">
                        <span style="font-size: 1.25rem;">⚽</span>
                        <h3 style="font-size: 1rem; font-weight: 600; color: var(--text);">FIFA World Cup Draft Pool</h3>
                    </div>
                    <div style="margin-bottom: 0.75rem;">
                        <span class="badge badge-live">Live</span>
                    </div>
                    <p style="font-size: 0.8125rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem;">
                        Fantasy draft order for 12 friends based on World Cup results. Monte Carlo simulation calibrates scoring across 4 team tiers. Multi-pool deployment, central admin hub, zero infrastructure.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
                        <span class="tech-tag">Workers</span>
                        <span class="tech-tag">KV</span>
                        <span class="tech-tag">TypeScript</span>
                    </div>
                </div>
            </a>

            <!-- Golf Practice Plan -->
            <a href="/projects/golf-practice-plan" style="text-decoration: none;">
                <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; transition: border-color 0.15s; height: 100%;" onmouseover="this.style.borderColor='var(--blue)'" onmouseout="this.style.borderColor='var(--border)'">
                    <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.75rem;">
                        <span style="font-size: 1.25rem;">⛳</span>
                        <h3 style="font-size: 1rem; font-weight: 600; color: var(--text);">Golf Practice Plan</h3>
                    </div>
                    <div style="margin-bottom: 0.75rem;">
                        <span class="badge badge-live">Live</span>
                    </div>
                    <p style="font-size: 0.8125rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem;">
                        12-week golf practice tracker with cross-device KV sync. PIN-based authentication, session model, mobile-first UX. Built without a framework in ~1,500 lines of TypeScript.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
                        <span class="tech-tag">Workers</span>
                        <span class="tech-tag">KV</span>
                        <span class="tech-tag">Hono</span>
                    </div>
                </div>
            </a>

            <!-- AI Sales Co-Pilot (Live) -->
            <a href="/projects/ai-sales-copilot" style="text-decoration: none;">
                <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; transition: border-color 0.15s; height: 100%;" onmouseover="this.style.borderColor='var(--blue)'" onmouseout="this.style.borderColor='var(--border)'">
                    <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.75rem;">
                        <span style="font-size: 1.25rem;">💼</span>
                        <h3 style="font-size: 1rem; font-weight: 600; color: var(--text);">AI Technical Sales Co-Pilot</h3>
                    </div>
                    <div style="margin-bottom: 0.75rem;">
                        <span class="badge badge-live">Live</span>
                    </div>
                    <p style="font-size: 0.8125rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem;">
                        Describe a prospect's tech stack — get back a Cloudflare migration plan, component mapping, and cost comparison. Grounded in an 80-chunk Vectorize RAG knowledge base.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
                        <span class="tech-tag">Workers AI</span>
                        <span class="tech-tag">Vectorize</span>
                        <span class="tech-tag">KV</span>
                        <span class="tech-tag">D1</span>
                    </div>
                </div>
            </a>

            <!-- SE Intel (Live) -->
            <a href="/projects/se-intel" style="text-decoration: none;">
                <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; transition: border-color 0.15s; height: 100%;" onmouseover="this.style.borderColor='var(--blue)'" onmouseout="this.style.borderColor='var(--border)'">
                    <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.75rem;">
                        <span style="font-size: 1.25rem;">🧠</span>
                        <h3 style="font-size: 1rem; font-weight: 600; color: var(--text);">SE Intel</h3>
                    </div>
                    <div style="margin-bottom: 0.75rem;">
                        <span class="badge badge-live">Live</span>
                    </div>
                    <p style="font-size: 0.8125rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem;">
                        Role-gated multi-agent intelligence platform. Two agents, five roles, three-tier RAG knowledge base, streaming SSE, cross-session memory, and an LLM-as-judge eval harness.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
                        <span class="tech-tag">Durable Objects</span>
                        <span class="tech-tag">Workers AI</span>
                        <span class="tech-tag">Vectorize</span>
                        <span class="tech-tag">D1</span>
                    </div>
                </div>
            </a>

            <!-- Zero Trust Demo Lab (Live) -->
            <a href="/projects/zero-trust-demo-lab" style="text-decoration: none;">
                <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; transition: border-color 0.15s; height: 100%;" onmouseover="this.style.borderColor='var(--blue)'" onmouseout="this.style.borderColor='var(--border)'">
                    <div style="display: flex; align-items: center; gap: 0.625rem; margin-bottom: 0.75rem;">
                        <span style="font-size: 1.25rem;">🔒</span>
                        <h3 style="font-size: 1rem; font-weight: 600; color: var(--text);">Zero Trust Demo Lab</h3>
                    </div>
                    <div style="margin-bottom: 0.75rem;">
                        <span class="badge badge-live">Live</span>
                    </div>
                    <p style="font-size: 0.8125rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem;">
                        BYOD device enrolled in Cloudflare WARP, Gateway policies enforcing identity-aware web filtering, and Access protecting a live Workers app — end-to-end Zero Trust without a VPN.
                    </p>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
                        <span class="tech-tag">WARP</span>
                        <span class="tech-tag">Gateway</span>
                        <span class="tech-tag">Access</span>
                        <span class="tech-tag">GCP</span>
                        <span class="tech-tag">Workers</span>
                    </div>
                </div>
            </a>
        </div>
    </section>

    {latestDigest && (
        <section style="margin-bottom: 4rem;">
            <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.5rem;">
                <h2 style="font-size: 0.8125rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em;">Digest</h2>
                <a href="/digest" style="font-size: 0.8125rem; color: var(--text-dim); text-decoration: none;">View all &rarr;</a>
            </div>

            <a href={`/digest/${latestDigest.id.replace(/\.mdx?$/, '')}`} style="text-decoration: none;">
                <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; transition: border-color 0.15s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
                    <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 0.625rem;">
                        <div style="display: flex; align-items: center; gap: 0.625rem; flex-wrap: wrap;">
                            {latestDigest.data.type === 'weekly' ? (
                                <span style="display: inline-flex; align-items: center; padding: 0.125rem 0.625rem; border-radius: 1rem; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; background: var(--amber-bg); color: var(--amber-text);">Weekly</span>
                            ) : (
                                <span style="display: inline-flex; align-items: center; padding: 0.125rem 0.625rem; border-radius: 1rem; font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; background: var(--surface); border: 1px solid var(--border); color: var(--text-dim);">Daily</span>
                            )}
                            <h3 style="font-size: 1rem; font-weight: 600; color: var(--text); line-height: 1.4;">{latestDigest.data.title}</h3>
                        </div>
                        <span style="font-size: 0.75rem; color: var(--text-dim); white-space: nowrap; padding-top: 0.2rem;">
                            {new Date(latestDigest.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                        </span>
                    </div>
                    <p style="font-size: 0.8125rem; color: var(--text-muted); line-height: 1.6;">{latestDigest.data.description}</p>
                </div>
            </a>
        </section>
    )}

</Base>
